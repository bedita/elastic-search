parameters:
	ignoreErrors:
		-
			identifier: missingType.iterableValue

		-
			identifier: missingType.generics

		-
			message: '#^Method BEdita\\ElasticSearch\\Adapter\\ElasticSearchAdapter\:\:buildElasticSearchQuery\(\) should return array\<array\{id\: string, score\: float\}\> but returns array\<int, mixed\>\.$#'
			identifier: return.type
			count: 1
			path: src/Adapter/ElasticSearchAdapter.php

		-
			message: "#^Access to an undefined property Cake\\\\Datasource\\\\EntityInterface\\:\\:\\$id\\.$#"
			count: 2
			path: src/Model/Index/SearchIndex.php
